# ==============================================================================
# AutoBugHunter 24/7 - Operational Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Integration & Dual-Account Separation
# ------------------------------------------------------------------------------
# ACCOUNT 1: Main account (@bitxwolf)
# - Manages and pushes BugHunter source code.
# - SOLE AUTHORITY to review and merge pull requests on GitHub.
#
# ACCOUNT 2: Bot account (@arrshh12)
# - Dedicated to autonomous bug scanning, atomic fix branching, and opening PRs.
# - Responds to review comments (CodeRabbit, humans) and resolves threads.
# - STRICT PROTOCOL: AutoBugHunter NEVER auto-merges any pull request (RULE-NO-AUTOMERGE).
#
# Bot Personal Access Token for @arrshh12:
# (Supports BOT_GITHUB_TOKEN or GITHUB_TOKEN)
BOT_GITHUB_TOKEN=your_arrshh12_bot_github_token_here
GITHUB_TOKEN=your_arrshh12_bot_github_token_here

# Strict No-AutoMerge Protocol: Always false. Attempting to set to true raises ValueError.
ENABLE_AUTO_MERGE=false

# Comma-separated list of 20+ GitHub repositories to continuously audit.
# Format: owner/repo1,owner/repo2,owner/repo3
TARGET_REPOS=bitxwolf/Airllm-tui,bitxwolf/orb,bitxwolf/worldof3js,bitxwolf/medical-for-non-medics,bitxwolf/BugHunter

# Set to true to automatically discover accessible non-fork, non-archived repositories
# via the GitHub REST API if TARGET_REPOS is left empty.
AUTO_DISCOVER_REPOS=false

# ------------------------------------------------------------------------------
# 2. Multi-Key LLM Routing Pool (ScaleMax + Fallbacks)
# ------------------------------------------------------------------------------
# Prioritized list of OpenAI-compatible endpoints.
# Primary: ScaleMax (openai/gpt-6-luna)
# Endpoint: https://api.scalemax.pro/v1
# Fallbacks: Backup ScaleMax keys or Free Tier endpoints (OpenRouter/Groq/Gemini).
# Format: base_url|model|api_key,base_url|model|api_key or provider|base_url|model|api_key
# Alternatively supports valid JSON array: [{"base_url": "...", "model": "...", "api_key": "..."}]
LLM_KEYS_POOL=https://api.scalemax.pro/v1|openai/gpt-6-luna|your_scalemax_primary_key_here,https://openrouter.ai/api/v1|openai/deepseek/deepseek-chat:free|your_openrouter_free_key_here

# Alternatively, configure a single OpenAI-compatible ScaleMax key directly:
# OPENAI_API_BASE=https://api.scalemax.pro/v1
# OPENAI_API_KEY=your_scalemax_primary_key_here
# LLM_MODEL=openai/gpt-6-luna

# ------------------------------------------------------------------------------
# 3. Pull Request Safety Guardrails & Diff Bounds
# ------------------------------------------------------------------------------
# Maximum number of concurrently open bot PRs per repository before pausing scans.
MAX_OPEN_PRS_PER_REPO=7

# Maximum number of files permitted in a single atomic bug fix PR (diff boundary).
MAX_FILES_PER_PR=3

# Maximum total lines changed (additions + deletions) permitted in a single fix.
MAX_DIFF_LINES=150

# ------------------------------------------------------------------------------
# 4. Daemon Scheduling & Execution Timeouts
# ------------------------------------------------------------------------------
# Delay in seconds between successive repository scan cycles.
SCAN_COOLDOWN_SECONDS=60

# Hard timeout in seconds for OpenHands headless agent subprocess execution.
AGENT_TIMEOUT_SECONDS=1200

# Subprocess timeout in seconds for static pre-filters (Ruff, Semgrep).
STATIC_SCAN_TIMEOUT_SECONDS=90

# Subprocess timeout in seconds for Git operations and gh CLI calls.
GIT_TIMEOUT_SECONDS=120

# Timeout in seconds for preflight health pings to LLM endpoints.
PREFLIGHT_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 5. Mission Control UI Dashboard
# ------------------------------------------------------------------------------
# Host interface for FastAPI Mission Control dashboard server.
# Set to 127.0.0.1 for local/loopback only (recommended).
# Set to 0.0.0.0 only when deploying behind an authenticated reverse proxy or with DASHBOARD_API_KEY.
DASHBOARD_HOST=127.0.0.1

# Port for FastAPI Mission Control dashboard server.
DASHBOARD_PORT=8080

# Secret API Key protecting Mission Control administrative endpoints and state.
# Required for any remote (non-loopback) access. When unset, remote access returns 403 Forbidden.
DASHBOARD_API_KEY=your_secure_dashboard_api_key_here

# ------------------------------------------------------------------------------
# 6. Storage Paths & Logging Configuration
# ------------------------------------------------------------------------------
# Base directory for workspace storage.
WORKSPACE_DIR=./workspace

# Directory housing cloned target repositories.
REPOS_DIR=./workspace/repos

# Directory housing SQLite WAL database, state cache, and persistent logs.
STATE_DIR=./workspace/state

# Path to persistent SQLite WAL database.
DB_PATH=./workspace/state/bughunter.sqlite

# Path to rotating daemon log file.
LOG_FILE_PATH=./bughunter.log

# Capacity of in-memory log buffer for WebSocket dashboard streaming replay.
LOG_RING_BUFFER_SIZE=500

# ------------------------------------------------------------------------------
# 7. Agent Process Runtime
# ------------------------------------------------------------------------------
# Headless runtime mode for OpenHands execution inside container.
RUNTIME=process
